generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Locale {
  ru
  en
}

enum RoomStatus {
  open
  live
  ended
}

enum MemberRole {
  host
  mod
  viewer
}

enum FriendshipStatus {
  pending
  accepted
  blocked
}

enum EntitlementKind {
  theme
  flair
  decoration
  nameplate
  capability
}

enum EntitlementSource {
  grant
  promo
  admin
  stars
  web
}

enum NotificationChannel {
  web
  telegram
}

model User {
  id          String   @id @default(cuid())
  telegramId  BigInt?  @unique
  username    String?  @unique
  displayName String
  locale      Locale   @default(ru)
  themeId     String   @default("ember")
  avatarUrl   String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  sessions                  Session[]
  hostedRooms               Room[]                   @relation("RoomHost")
  memberships               RoomMember[]
  messages                  Message[]
  reactions                 Reaction[]
  friendshipsRequested      Friendship[]             @relation("FriendshipRequester")
  friendshipsReceived       Friendship[]             @relation("FriendshipAddressee")
  entitlements              Entitlement[]
  achievements              UserAchievement[]
  notificationPreferences   NotificationPreference[]
  queueItems                QueueItem[]
}

model Session {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash String   @unique
  userAgent String?
  expiresAt DateTime
  createdAt DateTime @default(now())

  @@index([userId])
}

model Room {
  id          String     @id @default(cuid())
  slug        String     @unique
  title       String
  hostId      String
  host        User       @relation("RoomHost", fields: [hostId], references: [id])
  status      RoomStatus @default(open)
  layout      Json
  videoAspect  Float      @default(1.777777)
  isPublic     Boolean    @default(false)
  nowPlayingId String?    @unique
  nowPlaying   QueueItem? @relation("NowPlaying", fields: [nowPlayingId], references: [id])
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt

  members  RoomMember[]
  messages Message[]
  queue    QueueItem[]   @relation("RoomQueue")

  @@index([hostId])
  @@index([isPublic, createdAt])
}

model RoomMember {
  id       String     @id @default(cuid())
  roomId   String
  userId   String
  role     MemberRole @default(viewer)
  muted    Boolean    @default(false)
  joinedAt DateTime   @default(now())
  leftAt   DateTime?
  room     Room       @relation(fields: [roomId], references: [id], onDelete: Cascade)
  user     User       @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([roomId, userId])
  @@index([userId])
}

model Friendship {
  id          String           @id @default(cuid())
  requesterId String
  addresseeId String
  status      FriendshipStatus @default(pending)
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt
  requester   User             @relation("FriendshipRequester", fields: [requesterId], references: [id], onDelete: Cascade)
  addressee   User             @relation("FriendshipAddressee", fields: [addresseeId], references: [id], onDelete: Cascade)

  @@unique([requesterId, addresseeId])
  @@index([addresseeId])
}

model Message {
  id        String     @id @default(cuid())
  roomId    String
  userId    String
  body      String
  replyToId String?
  createdAt DateTime   @default(now())
  room      Room       @relation(fields: [roomId], references: [id], onDelete: Cascade)
  user      User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  replyTo   Message?   @relation("MessageReplies", fields: [replyToId], references: [id])
  replies   Message[]  @relation("MessageReplies")
  reactions Reaction[]

  @@index([roomId, createdAt])
}

model QueueItem {
  id             String   @id @default(cuid())
  roomId         String
  url            String
  provider       String
  externalId     String
  title          String
  position       Int
  addedById      String
  played         Boolean  @default(false)
  createdAt      DateTime @default(now())
  room           Room     @relation("RoomQueue", fields: [roomId], references: [id], onDelete: Cascade)
  addedBy        User     @relation(fields: [addedById], references: [id], onDelete: Cascade)
  nowPlayingFor  Room?    @relation("NowPlaying")

  @@index([roomId, position])
}

model Reaction {
  id        String   @id @default(cuid())
  messageId String
  userId    String
  emoji     String
  createdAt DateTime @default(now())
  message   Message  @relation(fields: [messageId], references: [id], onDelete: Cascade)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([messageId, userId, emoji])
}

/// Catalog stub. Rows are inserted when the product starts awarding them.
model Achievement {
  id            String            @id @default(cuid())
  key           String            @unique
  titleRu       String
  titleEn       String
  descriptionRu String
  descriptionEn String
  points        Int               @default(0)
  users         UserAchievement[]
}

model UserAchievement {
  id            String      @id @default(cuid())
  userId        String
  achievementId String
  awardedAt     DateTime    @default(now())
  user          User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  achievement   Achievement @relation(fields: [achievementId], references: [id], onDelete: Cascade)

  @@unique([userId, achievementId])
}

/// `kind` stays a string so new notification kinds do not need a migration.
model NotificationPreference {
  id      String              @id @default(cuid())
  userId  String
  channel NotificationChannel
  kind    String
  enabled Boolean             @default(true)
  user    User                @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, channel, kind])
}

model Entitlement {
  id        String            @id @default(cuid())
  userId    String
  sku       String
  kind      EntitlementKind
  source    EntitlementSource @default(grant)
  active    Boolean           @default(true)
  expiresAt DateTime?
  createdAt DateTime          @default(now())
  user      User              @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, sku])
  @@index([userId, active])
}
