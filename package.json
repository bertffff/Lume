{
  "name": "lume",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.33.4",
  "engines": {
    "node": ">=22.18"
  },
  "scripts": {
    "dev": "turbo run dev --parallel",
    "build": "turbo run build",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "db:generate": "pnpm --filter @lume/db db:generate",
    "db:migrate": "pnpm --filter @lume/db db:migrate"
  },
  "devDependencies": {
    "turbo": "2.11.10",
    "typescript": "5.9.3"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "@prisma/client",
      "@prisma/engines",
      "esbuild",
      "lightningcss",
      "msgpackr-extract",
      "prisma",
      "tsx"
    ]
  }
}
